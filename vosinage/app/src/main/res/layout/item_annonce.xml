<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Image de l'annonce -->
        <ImageView
            android:id="@+id/ivPhotoAnnonce"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:background="#E5E7EB"
            android:contentDescription="Photo de l'annonce"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" />

        <!-- Informations de l'annonce -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Titre -->
            <TextView
                android:id="@+id/tvTitreAnnonce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Voiture Golf 6 à vendre"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Prix -->
            <TextView
                android:id="@+id/tvPrixAnnonce"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="40.000 DT"
                android:textColor="#1E3A8A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Badges Catégorie + Type transaction -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCategorieAnnonce"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#EFF6FF"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Voiture"
                    android:textColor="#1D4ED8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTransactionAnnonce"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="#ECFDF5"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Vente"
                    android:textColor="#047857"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- État et Localisation -->
            <TextView
                android:id="@+id/tvEtatLocalisation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="État : Comme neuf • Nabeul"
                android:textColor="#6B7280"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>